# Smart Assignment Configuration
# ===============================
# Copy this file to .env and fill in real values. Never commit .env itself.
#
# This file documents ALL tunable parameters for the smart-assignment workflow.
# Defaults are reasonable starting points; confirm with operations before deploy.
# See smart_assignment/shared/config.py for the Config dataclass definition.


# === Hard Constraints ===

# === Hard Constraints ===

# Max route utilization after adding a customer (0.0-1.0)
# Default: 0.90
SMART_ASSIGNMENT_MAX_UTILIZATION=0.90

# Hard cap on customer->route-center distance (miles)
# Default: 25.0
SMART_ASSIGNMENT_MAX_SERVICE_MILES=25.0

# === Candidate Identification ===

# How many nearest routes to evaluate
# Default: 3
SMART_ASSIGNMENT_TOP_N=3

# Keep nearest route matching preferred day, even if distant
# Default: true
SMART_ASSIGNMENT_USE_PREFERRED_DAY_CANDIDATE=true

# === Scoring ===

# Distance at which clustering score decays to ~0
# Default: 15.0
SMART_ASSIGNMENT_CLUSTER_REF_MILES=15.0

# Percentage points below max_utilization where capacity_buffer stays flat
# Default: 0.15
SMART_ASSIGNMENT_CAPACITY_SAFETY_MARGIN=0.15

# === Slot Selection ===

# How many of a route's nearest committed stops are adjacent
# Default: 3
SMART_ASSIGNMENT_SLOT_NEIGHBORS=3

# Optional cap on committed stop distance (miles); leave empty for no cap
SMART_ASSIGNMENT_SLOT_NEIGHBOR_MAX_MILES=

# Length of each candidate delivery window (minutes), centered on time
# Default: 180
SMART_ASSIGNMENT_SLOT_WINDOW_MINUTES=180

# Reference times farther apart than this start a new time-cluster (minutes)
# Default: 180
SMART_ASSIGNMENT_SLOT_CLUSTER_GAP=180

# Top-N candidate slots kept per route; preference-overlapping always kept
# Default: 3
SMART_ASSIGNMENT_SLOT_CANDIDATES=3

# Proximity-weight share of the slot's cluster (slot ranking)
# Default: 0.5
SMART_ASSIGNMENT_SLOT_WEIGHT_FIT=0.5

# Emptier windows (fewer overlapping stops) are better (slot ranking)
# Default: 0.2
SMART_ASSIGNMENT_SLOT_WEIGHT_CONTENTION=0.2

# === Route-Slot Scoring ===

# Geographic clustering weight in route-slot score
# Default: 0.35
SMART_ASSIGNMENT_RS_WEIGHT_GEO=0.35

# Capacity buffer weight in route-slot score
# Default: 0.25
SMART_ASSIGNMENT_RS_WEIGHT_CAPACITY=0.25

# Window match weight in route-slot score (only when preference stated)
# Default: 0.20
SMART_ASSIGNMENT_RS_WEIGHT_WINDOW=0.20

# Slot availability weight in route-slot score
# Default: 0.20
SMART_ASSIGNMENT_RS_WEIGHT_AVAILABILITY=0.20

# Harm weight for tier 5 / Perks committed stops in slot openness
# Default: 1.0
SMART_ASSIGNMENT_SLOT_HARM_HIGH=1.0

# Harm weight for tier 4 committed stops in slot openness
# Default: 0.6
SMART_ASSIGNMENT_SLOT_HARM_MID=0.6

# Harm weight for Other-tier committed stops in slot openness
# Default: 0.1
SMART_ASSIGNMENT_SLOT_HARM_LOW=0.1

# Harm weight for unknown-tier committed stops in slot openness
# Default: 0.4
SMART_ASSIGNMENT_SLOT_HARM_UNKNOWN=0.4

# Auto-assign bar: chosen route-slot must meet this score else escalate
# Default: 0.55
SMART_ASSIGNMENT_ROUTE_SLOT_SCORE_THRESHOLD=0.55

# === Decision & Escalation ===

# Let the LLM make the recommend-vs-escalate call itself
# Default: true
SMART_ASSIGNMENT_USE_GROUNDED_ROUTE_SLOT_ESCALATION=true

# Let the LLM pick the winning route-slot from enumerated options
# Default: false
SMART_ASSIGNMENT_USE_GROUNDED_ROUTE_SLOT_PICK=false

# Number of independent judgment samples for escalation-side cases
# Default: 3
SMART_ASSIGNMENT_JUDGMENT_SAMPLE_COUNT=3

# How k samples' decisions are combined: unanimous | majority
# Default: unanimous
SMART_ASSIGNMENT_JUDGMENT_CONSENSUS=unanimous

# Resample if first sample recommends with low confidence
# Default: true
SMART_ASSIGNMENT_JUDGMENT_RETRY_ON_LOW_CONFIDENCE=true

# === Optional Features ===

# Enable grounded address typo/ambiguity correction
# Default: true
SMART_ASSIGNMENT_USE_ADDRESS_RESOLUTION=true

# Enable escalation-triage sub-agent for specialist briefs
# Default: true
SMART_ASSIGNMENT_USE_ESCALATION_TRIAGE=true

# Remember cross-prospect facts in the same browser session (chat app only)
# Default: false
SMART_ASSIGNMENT_USE_SESSION_MEMORY=false

# === LLM Backend ===

# LLM backend: sage | standard
# Default: sage
SMART_ASSIGNMENT_LLM_BACKEND=sage

# Model for standard backend (bare Gemini name or litellm-style string)
# Default: gemini-3.5-flash
SMART_ASSIGNMENT_MODEL=gemini-3.5-flash

# Model for sage backend (sage-prefixed or gateway-exposed id)
# Default: sage-gemini-2.5-flash
SMART_ASSIGNMENT_SAGE_MODEL=sage-gemini-2.5-flash

# Route sage calls through LLM Gateway instead of direct agent
# Default: false
SMART_ASSIGNMENT_USE_SAGE_GATEWAY=false

# === Backend Compatibility ===

# Number of times a sage request may be attempted before failure
# Default: 2
SMART_ASSIGNMENT_SAGE_REQUEST_ATTEMPTS=2

# Repair tool call args wrapped in JSON array (sage backend quirk)
# Default: true
SMART_ASSIGNMENT_REPAIR_TOOL_CALL_ARGS=true

# === Diagnostics ===

# Log true sage response when SDK masks it with generic error
# Default: false
SMART_ASSIGNMENT_DEBUG_SAGE_RESPONSE=false

# === Observability ===

# Enable OpenTelemetry tracing to OTLP backend (Langfuse, Phoenix, etc.)
# Default: false
SMART_ASSIGNMENT_USE_TRACING=false

# Enable human feedback loop (thumbs-up/down + notes)
# Default: false
SMART_ASSIGNMENT_USE_HUMAN_FEEDBACK=false

# Scrub PII from feedback notes before logging (default ON)
# Default: true
SMART_ASSIGNMENT_FEEDBACK_SCRUB_PII=true

# Path to append-only JSONL feedback log
# Default: feedback_data/annotations.jsonl
SMART_ASSIGNMENT_FEEDBACK_LOG_PATH=feedback_data/annotations.jsonl

# Include decision input/output in trace spans (OpenInference format)
# Default: false
SMART_ASSIGNMENT_USE_TRACE_DATASET_PAYLOADS=false

# Enable judge calibration harness (advisory, off by default)
# Default: false
SMART_ASSIGNMENT_USE_JUDGE_CALIBRATION=false

# Path to append-only JSONL log of automated judge verdicts
# Default: feedback_data/judge_verdicts.jsonl
SMART_ASSIGNMENT_JUDGE_LOG_PATH=feedback_data/judge_verdicts.jsonl
